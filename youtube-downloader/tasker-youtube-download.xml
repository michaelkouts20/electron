<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasker Project Backup — YouTube Scheduled Download
  ===================================================
  How to import:
    1. Open Tasker → top-right menu → Data → Restore → User Local Backup
       (or long-press the Tasker icon → pick this file from Downloads)
    2. After import, open the task "Download Latest 5 Videos"
    3. Tap Action [0] (Variable Set) and replace CHANNEL_NAME_HERE with your channel handle
    4. Enable the profile "YouTube 06:40 Download"
    5. Grant Tasker the Accessibility Service permission when prompted

  Requires: Tasker with Accessibility Service enabled
  Target time: 06:40 every day (fires tomorrow at 06:40 Athens time)
-->
<TaskerData sr="" dvi="1" tv="6.3.13">

  <!-- ─── PROFILE: fires at 06:40 AM every day ─── -->
  <Profile sr="prof0" ve="2">
    <cdate>1749340800000</cdate>
    <edate>1749340800000</edate>
    <id>1</id>
    <mid0>1</mid0>
    <nme>YouTube 06:40 Download</nme>
    <Time sr="con0">
      <fh>6</fh>
      <fm>40</fm>
      <rep>false</rep>
    </Time>
  </Profile>

  <!-- ─── TASK: Download Latest 5 Videos ─── -->
  <Task sr="task0">
    <cdate>1749340800000</cdate>
    <edate>1749340800000</edate>
    <id>1</id>
    <nme>Download Latest 5 Videos</nme>
    <pri>5</pri>

    <!-- ═══════════════════════════════════════════════
         STEP 1: Set your YouTube channel URL
         Channel pre-configured: @thegametimehighlights
         No edit needed.
         ═══════════════════════════════════════════════ -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%CHANNEL_URL</Str>
      <Str sr="arg1" ve="3">https://www.youtube.com/@thegametimehighlights/videos</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 2: Fetch the 5 latest video IDs from the channel
         Uses YouTube's public RSS feed — no API key needed.
         Stores them as %VIDEO_ID1 through %VIDEO_ID5
         ═══════════════════════════════════════════════ -->
    <Action sr="act1" ve="7">
      <code>26</code>
      <Str sr="arg0" ve="3">
// Tasker JavaScript — fetch latest 5 video IDs from YouTube channel RSS

function httpGet(url) {
  var conn = new java.net.URL(url).openConnection();
  conn.setConnectTimeout(30000);
  conn.setReadTimeout(30000);
  conn.setRequestProperty("User-Agent", "Mozilla/5.0 (Linux; Android 12)");
  var stream = conn.inputStream;
  var reader = new java.io.BufferedReader(new java.io.InputStreamReader(stream, "UTF-8"));
  var result = "";
  var line;
  while ((line = reader.readLine()) !== null) {
    result += line;
  }
  reader.close();
  return result;
}

try {
  var channelUrl = global("CHANNEL_URL");

  // Step A: fetch channel page to extract the channel ID
  var page = httpGet(channelUrl);
  var idMatch = page.match(/"channelId":"(UC[^"]{22})"/);
  if (!idMatch) {
    // Try alternate key
    idMatch = page.match(/channel\/(UC[^"\/]{22})/);
  }

  if (!idMatch) {
    flash("Could not find channel ID. Check the channel URL in act0.");
    exit();
  }

  var channelId = idMatch[1];

  // Step B: fetch RSS feed (returns the 15 most recent videos, newest first)
  var rssUrl = "https://www.youtube.com/feeds/videos.xml?channel_id=" + channelId;
  var rss = httpGet(rssUrl);

  // Step C: extract video IDs
  var videoIds = [];
  var pattern = /&lt;yt:videoId&gt;([^&lt;]{11})&lt;\/yt:videoId&gt;/g;
  var m;
  while ((m = pattern.exec(rss)) !== null &amp;&amp; videoIds.length &lt; 5) {
    videoIds.push(m[1]);
  }

  if (videoIds.length === 0) {
    flash("No videos found in channel RSS feed.");
    exit();
  }

  // Step D: store each video ID as %VIDEO_ID1 .. %VIDEO_ID5
  for (var i = 0; i &lt; videoIds.length; i++) {
    setGlobal("VIDEO_ID" + (i + 1), videoIds[i]);
  }
  setGlobal("VIDEO_TOTAL", videoIds.length.toString());

} catch(e) {
  flash("Error fetching videos: " + e.message);
}
      </Str>
      <Int sr="arg1" val="0"/>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 3: Initialize loop counter
         ═══════════════════════════════════════════════ -->
    <Action sr="act2" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%COUNT</Str>
      <Str sr="arg1" ve="3">1</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- ─── LOOP START ─── -->
    <Action sr="act3" ve="7">
      <code>300</code>
      <Str sr="arg0" ve="3">loop_start</Str>
    </Action>

    <!-- Exit loop when COUNT > VIDEO_TOTAL -->
    <Action sr="act4" ve="7">
      <code>35</code>
      <Str sr="arg0" ve="3">%COUNT</Str>
      <Int sr="arg1" val="7"/>
      <Str sr="arg2" ve="3">%VIDEO_TOTAL</Str>
      <Int sr="arg3" val="0"/>
    </Action>
    <Action sr="act5" ve="7">
      <code>30</code>
      <Int sr="arg0" val="4"/>
      <Str sr="arg1" ve="3">loop_end</Str>
    </Action>
    <Action sr="act6" ve="7">
      <code>37</code>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 4: Build the video watch URL for this iteration
         %VIDEO_ID%COUNT uses Tasker variable indirection:
           when COUNT=1 it reads %VIDEO_ID1, when COUNT=2 reads %VIDEO_ID2, etc.
         ═══════════════════════════════════════════════ -->
    <Action sr="act7" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%CURRENT_VIDEO_URL</Str>
      <Str sr="arg1" ve="3">https://www.youtube.com/watch?v=%VIDEO_ID%COUNT</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 5: Open the video in the YouTube app
         ═══════════════════════════════════════════════ -->
    <Action sr="act8" ve="7">
      <code>400</code>
      <Str sr="arg0" ve="3">android.intent.action.VIEW</Str>
      <Str sr="arg1" ve="3">%CURRENT_VIDEO_URL</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">com.google.android.youtube</Str>
      <Str sr="arg6" ve="3"/>
      <Int sr="arg7" val="0"/>
    </Action>

    <!-- Wait for video page to load -->
    <Action sr="act9" ve="7">
      <code>38</code>
      <Int sr="arg0" val="6"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 6: Tap the Save/Download button
         Tries content description "Save video" first.
         If your YouTube version uses different text, edit this action
         and change arg3 to "Download video", "Save offline", or "Download".
         arg4=2 means search by content-description (accessibility label).
         ═══════════════════════════════════════════════ -->
    <Action sr="act10" ve="7">
      <code>537</code>
      <Str sr="arg0" ve="3">com.google.android.youtube</Str>
      <Str sr="arg1" ve="3"/>
      <Int sr="arg2" val="1"/>
      <Str sr="arg3" ve="3">Save video</Str>
      <Int sr="arg4" val="2"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="8000"/>
    </Action>

    <!-- Wait for quality dialog to appear -->
    <Action sr="act11" ve="7">
      <code>38</code>
      <Int sr="arg0" val="3"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 7: Select "Full HD" quality
         arg4=1 means search by visible text on screen.
         Falls back silently if only lower quality is available.
         ═══════════════════════════════════════════════ -->
    <Action sr="act12" ve="7">
      <code>537</code>
      <Str sr="arg0" ve="3">com.google.android.youtube</Str>
      <Str sr="arg1" ve="3"/>
      <Int sr="arg2" val="1"/>
      <Str sr="arg3" ve="3">Full HD</Str>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="4000"/>
    </Action>

    <!-- Wait for download to be queued -->
    <Action sr="act13" ve="7">
      <code>38</code>
      <Int sr="arg0" val="3"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ═══════════════════════════════════════════════
         STEP 8: Press Back to return to previous screen
         Uses Android's KEYCODE_BACK (keyevent 4) via shell
         ═══════════════════════════════════════════════ -->
    <Action sr="act14" ve="7">
      <code>123</code>
      <Str sr="arg0" ve="3">input keyevent 4</Str>
      <Int sr="arg1" val="0"/>
      <Str sr="arg2" ve="3"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="1"/>
      <Str sr="arg5" ve="3"/>
    </Action>

    <!-- Wait for navigation -->
    <Action sr="act15" ve="7">
      <code>38</code>
      <Int sr="arg0" val="3"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ─── Increment counter and loop ─── -->
    <Action sr="act16" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%COUNT</Str>
      <Str sr="arg1" ve="3">%COUNT + 1</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Action>

    <Action sr="act17" ve="7">
      <code>30</code>
      <Int sr="arg0" val="4"/>
      <Str sr="arg1" ve="3">loop_start</Str>
    </Action>

    <!-- ─── LOOP END ─── -->
    <Action sr="act18" ve="7">
      <code>300</code>
      <Str sr="arg0" ve="3">loop_end</Str>
    </Action>

    <!-- ═══════════════════════════════════════════════
         DONE: Show notification
         ═══════════════════════════════════════════════ -->
    <Action sr="act19" ve="7">
      <code>553</code>
      <Str sr="arg0" ve="3">YouTube Downloader</Str>
      <Str sr="arg1" ve="3">%VIDEO_TOTAL videos queued for offline viewing</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="0"/>
    </Action>

  </Task>

</TaskerData>
